(type pod_file_t)
(call system_f (pod_file_t))
(allow pod_file_t self (filesystem (associate)))
(allow pod_file_t tmpfs_t (filesystem (associate)))
(allow pod_p pod_file_t (fs_classes (rw)))
(allow pod_containerd_t pod_file_t (fs_classes (rw)))
(allow pod_containerd_t pod_file_t (fs_classes (relabelfrom relabelto)))
(allow pod_containerd_t pod_file_t (file (execute execute_no_trans)))
(allow pod_containerd_t fs_t (filesystem (relabelfrom)))
(allow pod_containerd_t tmpfs_t (fs_classes (relabelfrom)))
(allow pod_containerd_t devpts_t (filesystem (relabelfrom)))
(allow pod_containerd_t kubelet_state_t (fs_classes (relabelfrom)))
(typealias container_file_t)
(typealiasactual container_file_t pod_file_t)
(allow kubelet_t kubelet_state_t (fs_classes (relabelfrom)))
(allow kubelet_t pod_file_t (fs_classes (relabelfrom relabelto)))

; Kubernetes workloads: pod_t and every type a module declares through the macros below.
; Whatever a module adds, these hold: no STATE, no machined socket, no ptrace on the host.
(typeattribute workload_p)
(neverallow workload_p system_state_t (file (read write)))
(neverallow workload_p system_socket_f (sock_file (write)))
(neverallow workload_p init_t (unix_stream_socket (connectto)))
(neverallow workload_p system_p (process (ptrace)))

; What the system needs to run a pod domain: the CRI transitions to it, supervises it and reaches its sockets, the kubelet
; signals it, and the domain runs from its own files, pod_file_t. A module narrowed to the accesses a workload exercised
; calls this one; pod_domain adds the rights of every pod.
(macro pod_plumbing ((type ARG1))
    (roletype system_r ARG1)
    (typeattributeset workload_p ARG1)
    (typeattributeset any_p ARG1)
    (allow pod_containerd_t ARG1 (process (transition)))
    (allow pod_containerd_t ARG1 (process2 (nnp_transition nosuid_transition)))
    (allow pod_containerd_t ARG1 (fs_classes (rw)))
    (allow pod_containerd_t ARG1 (process_classes (full)))
    (allow pod_containerd_t ARG1 (key (view read write search link setattr create)))
    (allow pod_containerd_t ARG1 (unix_stream_socket (connectto)))
    (allow ARG1 pod_containerd_t (fd (use)))
    (allow ARG1 pod_containerd_t (fifo_file (append getattr ioctl map open read rename setattr watch write)))
    (allow kubelet_t ARG1 (process_classes (signal)))
    (allow kubelet_t ARG1 (unix_stream_socket (connectto)))
    (allow ARG1 pod_file_t (fs_classes (rw)))
    (allow ARG1 pod_file_t (file (entrypoint execute execute_no_trans)))
    (typetransition ARG1 run_t file pod_containerd_run_t)
    (typetransition ARG1 run_t dir pod_containerd_run_t)
    (typetransition ARG1 run_t lnk_file pod_containerd_run_t)
    (typetransition ARG1 run_t chr_file pod_containerd_run_t)
    (typetransition ARG1 run_t blk_file pod_containerd_run_t)
    (typetransition ARG1 run_t fifo_file pod_containerd_run_t)
)

(macro pod_domain ((type ARG1))
    (call pod_plumbing (ARG1))
    (typeattributeset pod_p ARG1)
)
(typeattributeset workload_p pod_t)
(allow pod_t pod_file_t (file (entrypoint)))

(typeattribute privileged_readable_f)
(typeattributeset privileged_readable_f (and any_f (not (or protected_f (or protected_device_f (or system_socket_f unlabeled_t))))))

(macro pod_privileged_domain ((type ARG1))
    (call pod_domain (ARG1))
    (typeattributeset mcs_exempt_p ARG1)
    (allow ARG1 privileged_readable_f (fs_classes (ro)))
    (allow ARG1 any_p (fs_classes (ro)))
    (allow ARG1 run_t (fs_classes (rw)))
    (allow ARG1 cni_plugin_t (fs_classes (rw)))
    ; semctl(IPC_INFO) from lvm
    (allow ARG1 kernel_t (system (ipc_info)))
    (allow pod_p ARG1 (unix_stream_socket (connectto)))
)

(macro pod_hostmon_domain ((type ARG1))
    (call pod_domain (ARG1))
    (typeattributeset mcs_read_exempt_p ARG1)
    (allow ARG1 any_p (fs_classes (ro)))
)

(type pod_privileged_t)
(call pod_privileged_domain (pod_privileged_t))
(typetransition pod_containerd_t pod_file_t process pod_privileged_t)
(typealias spc_t)
(typealiasactual spc_t pod_privileged_t)
